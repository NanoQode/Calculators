# /etc/lmcmic/leads.env — lmcmic.ca lead endpoint settings
PORT=3310
LEAD_DATA_DIR=/var/lib/lmcmic
LEAD_NOTIFY_TO=deals@lendmaxcapital.ca
LEAD_REDIRECT_URL=https://app.lendmaxcapital.ca/investor-start
LEAD_SITE_ORIGIN=https://lmcmic.ca

# Email transport. With none of the keys below set, leads are relayed over
# HTTPS through formsubmit.co, which needs a one-time "Activate form" click in
# the deals@ inbox. Outbound SMTP ports 25/465/587 are blocked on this host,
# so use an HTTPS API for permanent delivery: set ONE of these and restart
# (systemctl restart lmcmic-leads). The sender domain must be verified with
# the provider (add its SPF/DKIM records in Cloudflare).
#LEAD_FROM="lmcmic.ca investor enquiries <leads@lmcmic.ca>"
#RESEND_API_KEY=
#POSTMARK_TOKEN=
#SENDGRID_API_KEY=
FORMSUBMIT_ENABLED=1
