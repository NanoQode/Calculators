# Copy to .env (never commit .env). Every value is optional in development.

# Canonical public origin, used in canonical tags, sitemaps, JSON-LD and emails. No trailing slash.
SITE_URL=https://instasure.ca
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Required in production: long random strings (e.g. `openssl rand -hex 32`).
SESSION_SECRET=
TRACKING_SECRET=

# First admin account, created on first start. If ADMIN_PASSWORD is empty, a random one is printed once.
ADMIN_EMAIL=admin@instasure.ca
ADMIN_PASSWORD=

# Storage (defaults: ./data/instasure.db and ./public/uploads)
DB_PATH=
UPLOADS_DIR=

# Outbound email. Without SMTP_HOST, emails are recorded in Admin → Email log with status "logged".
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Reverse proxy hops to trust for client IPs (Express "trust proxy" value).
TRUST_PROXY=loopback

# Ping IndexNow (Bing, Yandex, Seznam…) when content is published. Leave false on dev/staging.
INDEXNOW_ENABLED=false

# Drip scheduler. Set DRIP_DISABLED=true on every instance except one.
DRIP_INTERVAL_MS=60000
DRIP_DISABLED=false

# Anonymous HTML page cache TTL (default 5 minutes in production, off in development).
PAGE_CACHE_TTL_MS=300000
