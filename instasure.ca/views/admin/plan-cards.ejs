<%# Plan cards (pricing grid). usage: include('plan-cards', { plans, features, taxLabel, action: function(p){ return html } }) %>
<div class="grid grid-cols-1 md:grid-cols-<%= Math.min(plans.length, 3) %> gap-4 items-stretch">
  <% plans.forEach(function(p){ var hot = !!p.badge; %>
  <article class="relative flex flex-col rounded-3xl bg-surface-container-lowest p-6 <%= hot ? 'ring-2 ring-secondary shadow-lg md:-mt-2 md:mb-2' : 'shadow-sm border border-surface-container' %>">
    <% if (p.badge) { %><span class="absolute -top-3 left-6 badge !px-3 !py-1 bg-secondary text-on-secondary uppercase tracking-wider font-bold"><%= p.badge %></span><% } %>
    <h3 class="font-headline-md text-headline-md text-primary-container"><%= p.name %></h3>
    <p class="font-body-lg text-body-lg text-on-surface-variant"><strong class="text-on-surface"><%= p.leads_per_month %></strong> exclusive leads / month</p>
    <p class="mt-4 flex items-end gap-2"><span class="font-display-lg-mobile text-display-lg-mobile text-primary-container leading-none"><%= cadShort(p.price_per_lead_cents) %></span><span class="font-label-lg text-label-lg text-on-surface-variant pb-1">per lead</span></p>
    <p class="font-body-md text-body-md text-on-surface-variant mt-1"><%= cadShort(p.monthly_cents) %>/month + <%= taxLabel %></p>
    <div class="mt-5"><%- action(p) %></div>
    <hr class="my-5 border-surface-container">
    <ul class="flex flex-col gap-2 flex-1">
      <% features.concat(p.features || []).forEach(function(f){ %><li class="flex items-start gap-2 font-body-md text-body-md"><span class="material-symbols-outlined text-[20px] text-secondary">check</span><span><%= f %></span></li><% }) %>
    </ul>
    <% if (p.tagline) { %><p class="mt-5 font-body-sm text-body-sm text-on-surface-variant"><%= p.tagline %></p><% } %>
  </article>
  <% }) %>
</div>
