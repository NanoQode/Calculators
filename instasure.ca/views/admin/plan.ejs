<% var csrfField = '<input type="hidden" name="_csrf" value="' + csrf + '">';
   var approved = (a.status || 'approved') === 'approved';
   var tax = taxFor(bill.province); var taxLabel = tax.rate ? tax.label : 'applicable tax';
   var sub = b.sub; var active = b.active;
   var statusChip = { active: ['bg-secondary-container text-on-secondary-container', 'Active'], past_due: ['bg-error-container text-on-error-container', 'Payment due'], pending: ['bg-tertiary-fixed text-on-tertiary-fixed-variant', 'Awaiting payment'] };
   var kindLabel = { free_grant: 'Free leads', plan: 'Plan credits', lead: 'Lead delivered', returned: 'Credit returned', bad_lead: 'Bad-lead credit', adjust: 'Adjustment' }; %>
<%- include('partials-head', { h: 'Plan & billing', sub: 'Your lead credits, plan, invoices and billing details. One credit = one exclusive lead.', actions: '<a class="btn-soft !py-2 !px-4" href="/admin/preferences"><span class="material-symbols-outlined text-[18px]">tune</span>Lead preferences</a><a class="btn-soft !py-2 !px-4" href="/admin/leads">My leads</a>' }) %>

<% if (!approved) { %>
<div class="mb-4 rounded-xl px-4 py-3 bg-tertiary-fixed text-on-tertiary-fixed-variant font-body-md text-body-md flex items-start gap-2"><span class="material-symbols-outlined">hourglass_top</span><span><strong>Your licence is being checked.</strong> Once you’re approved, your <%= b.free.granted || s.free_leads %> free leads start arriving. No payment is needed until they’re used.</span></div>
<% } else if (b.outOfCredits && !active) { %>
<div class="mb-4 rounded-2xl px-5 py-4 bg-primary-container text-on-primary flex flex-col md:flex-row md:items-center gap-3">
  <span class="material-symbols-outlined text-secondary-fixed text-[32px]">celebration</span>
  <div class="flex-1"><p class="font-headline-sm text-headline-sm">You’ve used your <%= b.free.granted %> free leads</p><p class="font-body-md text-body-md text-primary-fixed-dim">New leads are paused. Choose a plan below to keep them coming — credits are added the moment your payment is confirmed.</p></div>
  <a class="btn-primary !py-2.5" href="#plans">See plans</a>
</div>
<% } else if (b.outOfCredits && active) { %>
<div class="mb-4 rounded-xl px-4 py-3 bg-tertiary-fixed text-on-tertiary-fixed-variant font-body-md text-body-md">You’ve used every lead credit for now. New credits arrive when your plan renews on <strong><%= U.fmtDate(sub.current_period_end) %></strong><%= b.openInvoice ? ' (once the renewal invoice is paid)' : '' %>, or switch to a bigger plan.</div>
<% } %>
<% if (sub && sub.status === 'past_due') { %><div class="mb-4 rounded-xl px-4 py-3 bg-error-container text-on-error-container font-body-md text-body-md">Your renewal payment is overdue. Leads you’ve already paid for still come through; new credits are added once it’s paid.</div><% } %>
<% if (b.openInvoice) { var oi = b.openInvoice; %>
<div class="mb-4 card p-4 flex flex-col md:flex-row md:items-center gap-3 ring-1 ring-secondary/30">
  <span class="material-symbols-outlined text-secondary">receipt_long</span>
  <div class="flex-1 font-body-md text-body-md"><strong>Invoice <%= oi.number %></strong> · <%= cad(oi.total_cents) %> due <%= U.fmtDate(oi.due_at) %> · <%= oi.leads %> lead credits once paid</div>
  <a class="btn-primary !py-2 !px-4" href="/admin/plan/invoices/<%= oi.id %>">View &amp; pay</a>
</div>
<% } %>

<div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-6">
  <div class="card p-4 <%= b.balance <= 0 && approved ? 'ring-2 ring-error/40' : '' %>"><p class="admin-label">Lead credits left</p><p class="font-headline-lg text-headline-lg text-primary-container"><%= Math.max(0, b.balance) %></p><p class="font-body-sm text-body-sm text-on-surface-variant">1 credit = 1 exclusive lead</p></div>
  <div class="card p-4"><p class="admin-label">Free leads</p><p class="font-headline-lg text-headline-lg text-primary-container"><%= b.free.used %><span class="font-headline-sm text-headline-sm text-on-surface-variant"> / <%= b.free.granted || s.free_leads %></span></p><p class="font-body-sm text-body-sm text-on-surface-variant"><%= b.free.granted ? (b.free.left ? b.free.left + ' still to come' : 'all used') : 'granted on approval' %></p></div>
  <div class="card p-4"><p class="admin-label">Plan</p><p class="font-headline-md text-headline-md text-primary-container"><%= active && b.plan ? b.plan.name : 'Free start' %></p><p class="font-body-sm text-body-sm text-on-surface-variant"><% if (sub && statusChip[sub.status]) { %><span class="badge <%= statusChip[sub.status][0] %>"><%= statusChip[sub.status][1] %></span><% } else { %>No paid plan yet<% } %></p></div>
  <div class="card p-4"><p class="admin-label"><%= active ? 'This period' : 'Leads received' %></p><p class="font-headline-lg text-headline-lg text-primary-container"><%= active ? b.periodUsed : b.delivered %><% if (active) { %><span class="font-headline-sm text-headline-sm text-on-surface-variant"> / <%= sub.leads_per_month %></span><% } %></p><p class="font-body-sm text-body-sm text-on-surface-variant"><%= active ? (sub.cancel_at_period_end ? 'Ends ' : 'Renews ') + U.fmtDate(sub.current_period_end, 'short') : 'all time' %></p></div>
</div>

<% if (active) { %>
<section class="card p-5 mb-6 flex flex-col lg:flex-row lg:items-center gap-4">
  <div class="flex-1">
    <h2 class="font-headline-sm text-headline-sm"><%= b.plan ? b.plan.name : 'Plan' %>: <%= sub.leads_per_month %> leads a month at <%= cadShort(sub.price_per_lead_cents) %> per lead</h2>
    <p class="font-body-md text-body-md text-on-surface-variant mt-1">
      <%= sub.provider === 'stripe' ? 'Paid by card; renews automatically' : 'Paid by invoice; we email the renewal invoice ' + s.renewal_notice_days + ' days before' %>.
      <% if (sub.cancel_at_period_end) { %><strong>Renewal is off</strong>: the plan ends <%= U.fmtDate(sub.current_period_end) %>. Unused credits stay on your balance.<% } else { %>Next renewal <%= U.fmtDate(sub.current_period_end) %><%= b.nextPlan ? ', switching to ' + b.nextPlan.name : '' %>.<% } %>
      Leads you don’t receive in a month carry over.
    </p>
  </div>
  <form method="post" action="/admin/plan/renewal" <%- sub.cancel_at_period_end ? '' : 'data-confirm="Turn off renewal? Your plan runs to the end of this period and your unused credits stay on your balance."' %>><%- csrfField %><input type="hidden" name="renew" value="<%= sub.cancel_at_period_end ? 1 : 0 %>"><button class="<%= sub.cancel_at_period_end ? 'btn-primary' : 'btn-soft' %> !py-2 !px-4"><%= sub.cancel_at_period_end ? 'Turn renewal back on' : 'Turn off renewal' %></button></form>
</section>
<% } %>

<section id="plans" class="mb-8 scroll-mt-6">
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-2 mb-5">
    <div><h2 class="font-headline-md text-headline-md text-primary-container"><%= active ? 'Change plan' : 'Choose a plan' %></h2>
      <p class="font-body-md text-body-md text-on-surface-variant">Priced per lead, billed monthly. Prices in CAD plus <%= taxLabel %><%= tax.rate ? ' (' + tax.rate + '% in ' + (provinces.find(function(p){ return p.code === bill.province; }) || {}).name + ')' : '' %>.<%= active ? ' A switch takes effect at your next renewal.' : '' %></p></div>
  </div>
  <%- include('plan-cards', { plans: plans, features: features, taxLabel: taxLabel, action: function(p){
    if (!approved) return '<span class="btn-soft w-full !cursor-default opacity-70">Available once you’re approved</span>';
    if (!active) return '<a class="' + (p.badge ? 'btn-primary' : 'btn-dark') + ' w-full" href="/admin/plan/checkout/' + p.slug + '">Choose ' + U.escapeHtml(p.name) + ' <span class="material-symbols-outlined text-[18px]">arrow_forward</span></a>';
    if (b.plan && p.id === b.plan.id && !b.nextPlan) return '<span class="btn-soft w-full !cursor-default"><span class="material-symbols-outlined text-[18px]">check_circle</span>Your current plan</span>';
    if (b.nextPlan && p.id === b.nextPlan.id) return '<span class="btn-soft w-full !cursor-default">Starts at renewal</span>';
    return '<form method="post" action="/admin/plan/change">' + csrfField + '<input type="hidden" name="plan" value="' + p.slug + '"><button class="btn-dark w-full">' + (b.plan && p.id === b.plan.id ? 'Keep ' : 'Switch to ') + U.escapeHtml(p.name) + ' at renewal</button></form>';
  } }) %>
</section>

<div class="grid grid-cols-1 xl:grid-cols-3 gap-4">
  <section class="card p-5 xl:col-span-2 overflow-x-auto">
    <h2 class="font-headline-sm text-headline-sm mb-3">Invoices</h2>
    <table class="w-full"><thead><tr><th class="admin-th">Invoice</th><th class="admin-th">Issued</th><th class="admin-th">For</th><th class="admin-th text-right">Total</th><th class="admin-th">Status</th></tr></thead>
      <tbody><% b.invoices.forEach(function(i){ %><tr><td class="admin-td"><a class="link font-mono text-body-sm" href="/admin/plan/invoices/<%= i.id %>"><%= i.number %></a></td><td class="admin-td text-body-sm"><%= U.fmtDate(i.issued_at, 'short') %></td><td class="admin-td text-body-sm"><%= i.leads %> leads<%= i.period_start ? ' · ' + U.fmtDate(i.period_start, 'short') + ' – ' + U.fmtDate(i.period_end, 'short') : '' %></td><td class="admin-td text-body-sm text-right"><%= cad(i.total_cents) %></td><td class="admin-td"><%- include('invoice-status', { st: i.status }) %></td></tr><% }) %>
        <% if (!b.invoices.length) { %><tr><td class="admin-td text-body-sm text-on-surface-variant" colspan="5">No invoices yet. Your free leads don’t need one.</td></tr><% } %></tbody></table>
  </section>
  <section id="billing-details" class="card p-5 scroll-mt-6">
    <h2 class="font-headline-sm text-headline-sm mb-1">Billing details</h2>
    <p class="font-body-sm text-body-sm text-on-surface-variant mb-3">Printed on your invoices. Your province sets the GST/HST rate.</p>
    <form method="post" action="/admin/plan/profile" class="grid gap-2"><%- csrfField %>
      <%- include('billing-fields', { bill: bill, field: null, provinces: provinces }) %>
      <button class="btn-soft !py-2">Save billing details</button>
    </form>
  </section>
  <section class="card p-5 xl:col-span-3 overflow-x-auto">
    <h2 class="font-headline-sm text-headline-sm mb-3">Credit history</h2>
    <table class="w-full"><thead><tr><th class="admin-th">When</th><th class="admin-th">What</th><th class="admin-th">Details</th><th class="admin-th text-right">Credits</th></tr></thead>
      <tbody><% b.ledger.forEach(function(c){ %><tr class="<%= c.reversed_at ? 'opacity-60' : '' %>"><td class="admin-td text-body-sm whitespace-nowrap"><%= U.fmtDate(c.created_at, 'short') %></td><td class="admin-td text-body-sm"><%= kindLabel[c.kind] || c.kind %><%= c.pool === 'free' && c.kind === 'lead' ? ' (free)' : '' %></td>
        <td class="admin-td text-body-sm"><% if (c.lead_id) { %><a class="link font-normal" href="/admin/leads/<%= c.lead_id %>"><%= ((c.first_name || '') + ' ' + (c.last_name || '')).trim() || c.ref %></a><%= c.reversed_at ? ' · credit returned' : '' %><% } else { %><%= c.note || '' %><% } %></td>
        <td class="admin-td text-body-sm text-right font-semibold <%= c.delta > 0 ? 'text-secondary' : '' %>"><%= c.delta > 0 ? '+' + c.delta : c.delta %></td></tr><% }) %>
        <% if (!b.ledger.length) { %><tr><td class="admin-td text-body-sm text-on-surface-variant" colspan="4">Nothing yet.</td></tr><% } %></tbody></table>
    <p class="font-body-sm text-body-sm text-on-surface-variant mt-2">Bad lead? Open it and use “Report a bad lead” within <%= s.bad_lead_window_days %> days of delivery. If we confirm it, the credit comes back here.</p>
  </section>
</div>
