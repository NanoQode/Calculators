<!DOCTYPE html>
<html lang="en-CA">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex,nofollow">
<title><%= typeof title !== 'undefined' ? title + ' · ' : '' %>Instasure Admin</title>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap">
<link rel="stylesheet" href="<%= fontUrl %>">
<link rel="stylesheet" href="/assets/site.css?v=<%= v %>">
<meta name="csrf-token" content="<%= csrf %>">
</head>
<body class="bg-surface-container-low text-on-surface font-body-md text-body-md min-h-screen">
<%
  var agentOnly = user.role === 'advisor';
  var nav = [
    ['Overview', [['/admin/me', 'space_dashboard', 'My portal', agentOnly ? 'advisor' : 'none'], ['/admin/', 'dashboard', 'Dashboard', agentOnly ? 'none' : 'viewer'], ['/admin/analytics', 'insights', 'Lead analytics', 'analytics'], ['/admin/reports/daily', 'summarize', 'Daily report', 'reports']]],
    ['Leads', [['/admin/leads', 'group', agentOnly ? 'My leads' : 'Leads', 'advisor', counts.newLeads], ['/admin/pipeline', 'view_kanban', 'Pipeline', 'advisor'], ['/admin/tasks', 'task_alt', 'Follow-ups', 'advisor', counts.overdue], ['/admin/campaigns', 'campaign', 'Drip campaigns', 'editor'], ['/admin/emails', 'mail', 'Email log', 'editor'], ['/admin/scoring', 'rule', 'Lead scoring', 'admin']]],
    ['Agents', [['/admin/advisors', 'support_agent', 'Agents', 'agents.manage', counts.pendingAgents], ['/admin/distribution', 'alt_route', 'Lead distribution', 'agents.manage'], ['/admin/profile', 'badge', 'My profile', agentOnly ? 'advisor' : 'none']]],
    ['Content', [['/admin/posts', 'article', 'Guides & blog', 'editor', counts.drafts], ['/admin/categories', 'filter_list', 'Categories', 'editor'], ['/admin/media', 'image', 'Media', 'editor']]],
    ['SEO', [['/admin/seo', 'travel_explore', 'SEO overview', 'editor'], ['/admin/seo/pages', 'manage_search', 'Pages & overrides', 'editor'], ['/admin/seo/keywords', 'query_stats', 'Keyword map', 'editor'], ['/admin/seo/redirects', 'route', 'Redirects & 404s', 'editor'], ['/admin/seo/crawlers', 'smart_toy', 'AI & search crawlers', 'editor']]],
    ['Site', [['/admin/geo', 'map', 'Provinces & cities', 'editor'], ['/admin/products', 'layers', 'Products', 'admin'], ['/admin/partners', 'handshake', 'Insurers & MGAs', 'admin'], ['/admin/sms', 'sms', 'SMS & verification', 'admin'], ['/admin/settings', 'settings', 'Settings', 'admin'], ['/admin/users', 'person', 'Users', 'admin'], ['/admin/audit', 'history', 'Audit log', 'admin']]],
  ];
  var isActive = function(href){ return href === '/admin/' ? currentPath === '/admin/' : currentPath.indexOf(href) === 0; };
%>
<div class="lg:flex">
  <aside class="lg:w-64 lg:shrink-0 lg:h-screen lg:sticky lg:top-0 bg-primary-container text-on-primary flex flex-col">
    <div class="flex items-center justify-between px-4 h-16">
      <a href="/admin/" class="flex items-center gap-2"><img src="/img/logo-mark.svg" alt="" class="w-7 h-7"><span class="font-headline-sm text-headline-sm">Instasure<span class="text-secondary-fixed">.ca</span></span></a>
      <button type="button" class="lg:hidden w-10 h-10 rounded-full hover:bg-surface-container-lowest/10 flex items-center justify-center" data-admin-menu aria-label="Toggle menu"><span class="material-symbols-outlined">menu</span></button>
    </div>
    <nav class="hidden lg:block flex-1 overflow-y-auto px-2 pb-4" data-admin-nav>
      <% nav.forEach(function(sec){ var items = sec[1].filter(function(i){ return i[3] !== 'none' && can(i[3]); }); if (!items.length) return; %>
      <p class="px-3 mt-4 mb-1 font-label-sm text-label-sm uppercase tracking-wider text-on-primary-container"><%= sec[0] %></p>
      <% items.forEach(function(i){ var on = isActive(i[0]); %>
      <a href="<%= i[0] %>" class="flex items-center gap-3 px-3 py-2 rounded-lg font-label-md text-label-md <%= on ? 'bg-surface-container-lowest/15 text-on-primary' : 'text-primary-fixed-dim hover:bg-surface-container-lowest/10 hover:text-on-primary' %>">
        <span class="material-symbols-outlined text-[20px]"><%= i[1] %></span><span class="flex-1"><%= i[2] %></span>
        <% if (i[4]) { %><span class="badge bg-secondary-fixed text-on-secondary-fixed"><%= i[4] %></span><% } %>
      </a>
      <% }) }) %>
    </nav>
    <div class="hidden lg:flex items-center gap-2 px-4 py-3 border-t border-surface-container-lowest/10" data-admin-nav>
      <span class="w-8 h-8 rounded-full bg-secondary flex items-center justify-center font-label-md"><%= user.name.slice(0,1) %></span>
      <a href="/admin/account" class="flex-1 min-w-0 hover:opacity-90" title="My account"><p class="font-label-md text-label-md truncate"><%= user.name %></p><p class="font-label-sm text-label-sm text-on-primary-container"><%= roleLabel(user.role) %></p></a>
      <a href="/" target="_blank" class="w-8 h-8 rounded-full hover:bg-surface-container-lowest/10 flex items-center justify-center" title="View site"><span class="material-symbols-outlined text-[18px]">open_in_new</span></a>
      <form method="post" action="/admin/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="w-8 h-8 rounded-full hover:bg-surface-container-lowest/10 flex items-center justify-center" title="Sign out"><span class="material-symbols-outlined text-[18px]">logout</span></button></form>
    </div>
  </aside>
  <main class="flex-1 min-w-0 p-4 lg:p-8">
    <% if (flash) { %>
    <div class="mb-4 rounded-xl px-4 py-3 font-label-md text-label-md flex items-start gap-2 <%= flash.type === 'ok' ? 'bg-secondary-container/50 text-on-secondary-fixed' : 'bg-error-container text-on-error-container' %>" role="status">
      <span class="material-symbols-outlined text-[18px]"><%= flash.type === 'ok' ? 'check_circle' : 'warning' %></span><span><%= flash.msg %></span>
    </div>
    <% } %>
    <% if (typeof noteDue !== 'undefined' && noteDue && !(typeof lead !== 'undefined' && lead && lead.id === noteDue.id)) { %>
    <div class="mb-4 rounded-xl px-4 py-3 bg-tertiary-fixed text-on-tertiary-fixed-variant font-label-md text-label-md flex flex-wrap items-center gap-2" role="alert">
      <span class="material-symbols-outlined text-[18px]">edit_note</span>
      <span class="flex-1">Add a note to <strong><%= noteDue.name %></strong> (<span class="font-mono"><%= noteDue.ref %></span>) before you open another lead.</span>
      <a class="btn-primary !py-1.5 !px-3" href="/admin/leads/<%= noteDue.id %>#add-note">Add the note</a>
    </div>
    <% } %>
    <%- body %>
  </main>
</div>
<%- include('task-popup') %>
<script src="/js/admin.js?v=<%= v %>" defer></script>
</body>
</html>
