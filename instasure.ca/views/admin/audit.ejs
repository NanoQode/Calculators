<%- include('partials-head', { h: 'Audit log', sub: 'Who changed what — logins, publishes, exports, deletions and settings changes.' }) %>
<div class="card overflow-x-auto"><table class="w-full"><thead><tr><th class="admin-th">When</th><th class="admin-th">User</th><th class="admin-th">Action</th><th class="admin-th">Entity</th><th class="admin-th">Details</th></tr></thead><tbody>
<% rows.forEach(function(r){ %><tr><td class="admin-td text-body-sm whitespace-nowrap"><%= String(r.created_at).slice(0,16) %></td><td class="admin-td text-body-sm"><%= r.user_name || 'system' %></td><td class="admin-td text-body-sm"><%= r.action %></td><td class="admin-td text-body-sm"><%= r.entity %> <%= r.entity_id %></td><td class="admin-td text-[11px] text-on-surface-variant break-all max-w-md"><%= r.data %></td></tr><% }) %>
</tbody></table></div>
