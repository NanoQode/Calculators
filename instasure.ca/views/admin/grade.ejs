<% var g = l.grade || 'D'; var cls = { A: 'bg-secondary text-on-secondary', B: 'bg-secondary-container text-on-secondary-container', C: 'bg-surface-container text-on-surface', D: 'bg-surface-container-high text-on-surface-variant' }[g]; %>
<span class="badge <%= cls %>" title="Lead score <%= l.score %>/100"><%= g %> · <%= l.score %></span>
