<% var J = function(v){ return db_json(v, []); }; var provs = J(a.provinces), cats = J(a.categories), langs = J(a.languages); var lic = J(a.licences).map(function(l){ return [String(l.province || '').toUpperCase(), l.regulator, l.type, l.number, l.expires].map(function(x){ return x || ''; }).join(' | '); }).join('\n'); %>
<a href="/admin/advisors" class="font-label-md text-label-md text-on-surface-variant hover:text-secondary">← Advisors</a>
<%- include('partials-head', { h: a.id ? a.name : 'New advisor', sub: a.id ? '<a class="link" target="_blank" href="/advisors/' + a.slug + '/">Public profile ↗</a>' : '' }) %>
<form method="post" action="/admin/advisors?_csrf=<%= encodeURIComponent(csrf) %>" enctype="multipart/form-data" class="grid grid-cols-1 xl:grid-cols-3 gap-4">
  <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= a.id || '' %>">
  <section class="card p-5 grid grid-cols-2 gap-3 xl:col-span-2">
    <label><span class="admin-label">Full name</span><input class="admin-input" name="name" value="<%= a.name || '' %>" required></label>
    <label><span class="admin-label">Designations</span><input class="admin-input" name="designations" value="<%= a.designations || '' %>" placeholder="LLQP, CFP, CIP"></label>
    <label class="col-span-2"><span class="admin-label">Title</span><input class="admin-input" name="title" value="<%= a.title || '' %>" placeholder="Licensed Life & Health Advisor"></label>
    <label><span class="admin-label">Email (lead alerts)</span><input class="admin-input" type="email" name="email" value="<%= a.email || '' %>"></label>
    <label><span class="admin-label">Phone</span><input class="admin-input" name="phone" value="<%= a.phone || '' %>"></label>
    <label class="col-span-2"><span class="admin-label">Booking link (Calendly / Cal.com / Bookings — https)</span><input class="admin-input" name="booking_url" value="<%= a.booking_url || '' %>"></label>
    <label class="col-span-2"><span class="admin-label">Bio (Markdown) — experience, specialties, communities served</span><textarea class="admin-input min-h-[160px]" name="bio_md"><%= a.bio_md || '' %></textarea></label>
    <label class="col-span-2"><span class="admin-label">Licences — one per line: PROV | Regulator | Licence type | Number | Expiry</span><textarea class="admin-input font-mono text-body-sm" name="licences" rows="4" placeholder="ON | FSRA | Life & A&S agent | 12345678 | 2027-06-30"><%= lic %></textarea></label>
  </section>
  <section class="card p-5 flex flex-col gap-3 self-start">
    <div class="flex items-center gap-3"><%- include('../public/partials/avatar', { a: a.name ? a : null, size: 'w-16 h-16' }) %><label class="flex-1"><span class="admin-label">Photo (PNG/JPEG/WebP, max 5 MB)</span><input type="file" name="photo" accept="image/png,image/jpeg,image/webp" class="text-body-sm"></label></div>
    <input type="hidden" name="photo_url" value="<%= a.photo || '' %>">
    <fieldset><legend class="admin-label">Licensed provinces</legend><div class="grid grid-cols-4 gap-1"><% provinces.forEach(function(p){ %><label class="flex items-center gap-1 font-body-sm text-body-sm"><input type="checkbox" name="provinces" value="<%= p.code %>" <%= provs.indexOf(p.code) > -1 ? 'checked' : '' %>><%= p.abbr %></label><% }) %></div></fieldset>
    <fieldset><legend class="admin-label">Product categories</legend><div class="flex flex-col gap-1"><% Object.keys(CATEGORIES).forEach(function(k){ %><label class="flex items-center gap-2 font-body-sm text-body-sm"><input type="checkbox" name="categories" value="<%= k %>" <%= cats.indexOf(k) > -1 ? 'checked' : '' %>><%= CATEGORIES[k].name %></label><% }) %></div></fieldset>
    <fieldset><legend class="admin-label">Languages</legend><div class="grid grid-cols-2 gap-1"><% Object.keys(LANGS).forEach(function(k){ %><label class="flex items-center gap-1 font-body-sm text-body-sm"><input type="checkbox" name="languages" value="<%= k %>" <%= langs.indexOf(k) > -1 ? 'checked' : '' %>><%= LANGS[k] %></label><% }) %></div></fieldset>
    <div class="grid grid-cols-3 gap-2"><label><span class="admin-label">Years</span><input class="admin-input" type="number" name="years_experience" value="<%= a.years_experience || '' %>"></label><label><span class="admin-label">Weight</span><input class="admin-input" type="number" name="weight" value="<%= a.weight || 1 %>" min="1"></label><label><span class="admin-label">Max open</span><input class="admin-input" type="number" name="max_open_leads" value="<%= a.max_open_leads || '' %>"></label></div>
    <label class="flex items-center gap-2 font-label-md text-label-md"><input type="checkbox" name="active" value="1" <%= a.active ? 'checked' : '' %>> Active (public profile)</label>
    <label class="flex items-center gap-2 font-label-md text-label-md"><input type="checkbox" name="accepting_leads" value="1" <%= a.accepting_leads ? 'checked' : '' %>> Accepting new leads</label>
    <label class="flex items-center gap-2 font-label-md text-label-md"><input type="checkbox" name="is_demo" value="1" <%= a.is_demo ? 'checked' : '' %>> Sample profile (noindex, never emailed)</label>
    <button class="btn-primary !py-2">Save advisor</button>
  </section>
</form>
