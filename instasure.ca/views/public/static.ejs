    <aside class="lg:col-span-4 flex flex-col gap-space-md lg:sticky lg:top-24 self-start">
      <div class="card p-space-lg flex flex-col gap-2">
        <p class="font-label-sm text-label-sm uppercase tracking-wider text-on-surface-variant">Trust &amp; transparency</p>
        <a class="link" href="/about/">About us</a><a class="link" href="/how-we-make-money/">How we make money</a><a class="link" href="/editorial-guidelines/">Editorial guidelines</a><a class="link" href="/licensing/">Licensing &amp; disclosures</a><a class="link" href="/privacy/">Privacy policy</a><a class="link" href="/advisors/">Our advisors</a>
      </div>
      <a href="/quote/" class="btn-primary">Get an instant estimate <span class="material-symbols-outlined text-[18px]">bolt</span></a>
    </aside>
  </div>
</section>
