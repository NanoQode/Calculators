<section class="container-site pt-space-md pb-space-xl">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-xl">
    <div class="lg:col-span-8">
      <h1 class="font-display-lg-mobile text-display-lg-mobile lg:font-display-lg lg:text-display-lg text-primary-container tracking-tight"><%= page.title %></h1>
      <% if (page.updated) { %><p class="mt-2 font-label-md text-label-md text-on-surface-variant">Last updated <%= U.fmtDate(page.updated) %></p><% } %>
      <div class="article-body mt-space-lg"><%- page.html %></div>
