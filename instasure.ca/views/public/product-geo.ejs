<%
  var est = content.estimate;
  var fmt = function(n){ return U.money(n, { cents: n < 100 }); };
%>
<div class="relative w-full overflow-hidden">
  <div class="absolute -top-40 right-1/4 w-[520px] h-[520px] rounded-full bg-secondary-container/20 blur-[130px] pointer-events-none"></div>
  <section class="container-site pt-space-md pb-space-xl relative">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-xl items-start">
      <div class="lg:col-span-6 flex flex-col gap-space-md lg:pt-space-md">
        <div class="flex flex-wrap gap-space-xs">
          <span class="chip bg-secondary-container/40 text-on-secondary-container"><span class="material-symbols-outlined text-[15px]"><%= product.icon %></span> <%= product.name %></span>
          <span class="chip bg-surface-container text-on-surface"><span class="material-symbols-outlined text-[15px] text-secondary">location_on</span> <%= where %></span>
          <span class="chip bg-surface-container-lowest shadow-sm text-on-surface"><span class="material-symbols-outlined text-[15px] text-secondary">gavel</span> Regulated by <%= prov.regulator.short %></span>
        </div>
        <h1 class="font-display-lg-mobile text-display-lg-mobile lg:font-display-lg lg:text-display-lg text-primary-container tracking-tight text-balance"><%= h1 %></h1>
        <div class="article-body">
          <% content.intro.forEach(function(p){ %><p><%= p %></p><% }) %>
          <% if (intro) { %><%- intro %><% } %>
        </div>
        <% if (!serviceable) { %>
        <div class="flex items-start gap-3 p-space-md rounded-2xl bg-tertiary-fixed/60 text-on-tertiary-fixed-variant">
          <span class="material-symbols-outlined">info</span>
          <p class="font-body-sm text-body-sm"><strong>Advisor service isn’t available in <%= prov.name %> yet.</strong> You can still use our guides and instant estimates — <%= s.waitlist_message %></p>
        </div>
        <% } %>
        <div class="grid grid-cols-2 gap-space-sm">
          <% content.facts.forEach(function(f){ %>
          <div class="bg-surface-container-lowest/80 p-space-sm rounded-xl shadow-sm flex flex-col">
            <span class="font-label-sm text-label-sm text-on-surface-variant flex items-center gap-1"><span class="material-symbols-outlined text-[14px] text-secondary"><%= f.icon %></span><%= f.label %></span>
            <% if (f.url) { %><a href="<%= f.url %>" rel="noopener" target="_blank" class="font-label-lg text-label-lg text-on-surface hover:text-secondary"><%= f.value %></a><% } else { %><span class="font-label-lg text-label-lg text-on-surface"><%= f.value %></span><% } %>
            <% if (f.note) { %><span class="font-label-sm text-label-sm text-on-surface-variant font-normal"><%= f.note %></span><% } %>
          </div>
          <% }) %>
        </div>
      </div>
      <div class="lg:col-span-6 lg:sticky lg:top-24"><%- include('partials/quote-widget') %></div>
    </div>
  </section>
</div>

<section class="w-full bg-surface-container-lowest py-space-xl shadow-sm" aria-labelledby="cost-h">
  <div class="container-site grid grid-cols-1 lg:grid-cols-12 gap-space-lg">
    <div class="lg:col-span-5 flex flex-col gap-space-sm">
      <p class="eyebrow">Local estimate · <%= est.asOf %></p>
      <h2 id="cost-h" class="font-headline-lg-mobile text-headline-lg-mobile lg:font-headline-lg lg:text-headline-lg text-primary-container">How much does <%= product.name.toLowerCase() %> cost in <%= city ? city.name : prov.name %>?</h2>
      <p class="font-body-md text-body-md text-on-surface-variant">Instasure’s pricing model estimates the following range for an example profile. Your actual premium depends on your details and the insurer.</p>
    </div>
    <div class="lg:col-span-7 bg-surface-container-low rounded-3xl p-space-lg flex flex-col gap-space-md">
      <div class="flex flex-wrap items-end justify-between gap-space-sm">
        <div><span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Typical range</span><p class="font-price-hero-mobile text-price-hero-mobile lg:font-price-hero lg:text-price-hero text-primary-container"><%= fmt(est.low) %>–<%= fmt(est.high) %><span class="font-body-md text-body-md text-on-surface-variant"><%= est.periodLabel %></span></p></div>
        <a href="/quote/<%= product.slug %>/?province=<%= prov.code %><%= city ? '&city=' + city.slug : '' %>" class="btn-primary" data-track="quote_start" data-label="geo_cost_card">Personalise it <span class="material-symbols-outlined text-[18px]">arrow_forward</span></a>
      </div>
      <p class="font-body-sm text-body-sm text-on-surface-variant"><strong>Example profile:</strong> <%= est.example %>.</p>
      <div class="grid sm:grid-cols-3 gap-space-sm">
        <% est.tiers.forEach(function(t){ %>
        <div class="bg-surface-container-lowest rounded-xl p-space-sm <%= t.featured ? 'ring-2 ring-secondary/40' : '' %>">
          <span class="font-label-sm text-label-sm text-secondary"><%= t.label %></span>
          <p class="font-label-lg text-label-lg text-on-surface"><%= t.name %></p>
          <p class="font-headline-sm text-headline-sm text-primary-container"><%= fmt(t.monthly) %><span class="font-body-sm text-body-sm text-on-surface-variant"><%= est.periodLabel %></span></p>
        </div>
        <% }) %>
      </div>
      <% (est.notes || []).forEach(function(n){ %><p class="font-body-sm text-body-sm text-on-surface-variant flex gap-2"><span class="material-symbols-outlined text-[16px] text-secondary">info</span><%= n %></p><% }) %>
    </div>
  </div>
</section>

<section class="container-site py-space-xl grid grid-cols-1 lg:grid-cols-2 gap-space-lg">
  <div class="card p-space-lg">
    <div class="flex items-center gap-2 mb-space-sm"><span class="material-symbols-outlined text-on-tertiary-container">thunderstorm</span><h2 class="font-headline-md text-headline-md text-primary-container">Local risk factors in <%= city ? city.name : prov.name %></h2></div>
    <ul class="space-y-2">
      <% content.risks.forEach(function(r){ %><li class="flex items-start gap-2 font-body-md text-body-md text-on-surface"><span class="material-symbols-outlined text-[18px] text-on-tertiary-container mt-0.5">warning</span><span><%= r %></span></li><% }) %>
    </ul>
    <p class="font-body-sm text-body-sm text-on-surface-variant mt-space-md">Insurers price these risks by postal code. An advisor can tell you which endorsements are available at your address.</p>
  </div>
  <div class="card p-space-lg">
    <div class="flex items-center gap-2 mb-space-sm"><span class="material-symbols-outlined text-secondary">tune</span><h2 class="font-headline-md text-headline-md text-primary-container">What drives your <%= product.short.toLowerCase() %> premium</h2></div>
    <ol class="space-y-2">
      <% product.factors.forEach(function(f, i){ %><li class="flex items-start gap-3"><span class="w-6 h-6 rounded-full bg-surface-container flex items-center justify-center font-label-sm text-label-sm text-primary-container shrink-0"><%= i + 1 %></span><span class="font-body-md text-body-md text-on-surface"><%= f %></span></li><% }) %>
    </ol>
  </div>
</section>

<% if (content.notes.length) { %>
<section class="container-site pb-space-xl">
  <div class="rounded-3xl bg-primary-container text-on-primary p-space-lg relative overflow-hidden">
    <div class="absolute -right-10 -bottom-10 w-60 h-60 rounded-full bg-secondary/20 blur-3xl"></div>
    <p class="font-label-sm text-label-sm uppercase tracking-wider text-secondary-fixed mb-1">What’s changing in <%= prov.name %></p>
    <h2 class="font-headline-md text-headline-md mb-space-sm"><%= prov.name %> <%= product.category === 'auto' ? 'auto insurance' : 'insurance' %> updates (<%= year %>)</h2>
    <ul class="space-y-2 relative">
      <% content.notes.forEach(function(n){ %><li class="flex items-start gap-2 font-body-md text-body-md text-primary-fixed-dim"><span class="material-symbols-outlined text-[18px] text-secondary-fixed mt-0.5">east</span><span><%= n %></span></li><% }) %>
    </ul>
  </div>
</section>
<% } %>

<section class="w-full bg-surface-container-lowest py-space-xl shadow-sm">
  <div class="container-site">
    <h2 class="font-headline-md text-headline-md text-primary-container mb-space-md">Coverage options in <%= city ? city.name : prov.name %></h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-space-md">
      <% product.coverages.forEach(function(c){ %><div class="bg-surface-container-low rounded-2xl p-space-md"><h3 class="font-label-lg text-label-lg text-on-surface mb-1"><%= c.name %></h3><p class="font-body-sm text-body-sm text-on-surface-variant"><%= c.desc %></p></div><% }) %>
    </div>
  </div>
</section>

<% if (advisors.length) { %>
<section class="container-site py-space-xl" aria-labelledby="adv-h">
  <p class="eyebrow">Licensed in <%= prov.name %></p>
  <h2 id="adv-h" class="font-headline-md text-headline-md text-primary-container mb-space-md">Advisors who can help in <%= city ? city.name : prov.name %></h2>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-space-md"><% advisors.forEach(function(a){ %><%- include('partials/advisor-card', { a: a }) %><% }) %></div>
</section>
<% } %>

<%- include('partials/faq', { items: faq, faqHeading: product.name + ' in ' + (city ? city.name : prov.name) + ': FAQ' }) %>

<section class="container-site pb-space-xl grid grid-cols-1 lg:grid-cols-2 gap-space-lg">
  <% if (provCities.length && product.geo === 'city') { %>
  <div><h2 class="font-headline-sm text-headline-sm text-on-surface mb-space-sm"><%= product.name %> by city in <%= prov.name %></h2>
    <ul class="flex flex-wrap gap-2"><% provCities.forEach(function(c){ %><li><a href="/<%= product.slug %>/<%= prov.slug %>/<%= c.slug %>/" class="chip bg-surface-container-lowest shadow-sm text-on-surface hover:text-secondary !py-2 !px-3 font-label-md text-label-md"><%= c.name %></a></li><% }) %></ul></div>
  <% } else if (city && content.nearby.length) { %>
  <div><h2 class="font-headline-sm text-headline-sm text-on-surface mb-space-sm"><%= product.short %> insurance near <%= city.name %></h2>
    <ul class="flex flex-wrap gap-2"><% content.nearby.forEach(function(c){ var cp = geoData.provinceByCode[c.prov]; %><li><a href="/<%= product.slug %>/<%= cp.slug %>/<%= c.slug %>/" class="chip bg-surface-container-lowest shadow-sm text-on-surface hover:text-secondary !py-2 !px-3 font-label-md text-label-md"><%= c.name %></a></li><% }) %>
      <li><a href="/<%= product.slug %>/<%= prov.slug %>/" class="chip bg-surface-container text-secondary !py-2 !px-3 font-label-md text-label-md">All of <%= prov.name %> →</a></li></ul></div>
  <% } %>
  <div><h2 class="font-headline-sm text-headline-sm text-on-surface mb-space-sm">Other coverage in <%= city ? city.name : prov.name %></h2>
    <ul class="flex flex-wrap gap-2">
      <% otherProducts.forEach(function(o){ %><li><a href="/<%= o.slug %>/<%= prov.slug %>/<%= city && o.geo === 'city' ? city.slug + '/' : '' %>" class="chip bg-surface-container-lowest shadow-sm text-on-surface hover:text-secondary !py-2 !px-3 font-label-md text-label-md"><span class="material-symbols-outlined text-[16px] text-secondary"><%= o.icon %></span><%= o.short %></a></li><% }) %>
      <li><a href="/insurance/<%= prov.slug %>/<%= city ? city.slug + '/' : '' %>" class="chip bg-surface-container text-secondary !py-2 !px-3 font-label-md text-label-md">Insurance in <%= city ? city.name : prov.name %> →</a></li>
    </ul></div>
</section>

<% if (guides.length) { %>
<section class="container-site pb-space-xl"><h2 class="font-headline-md text-headline-md text-primary-container mb-space-md">Related guides</h2>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-space-lg"><% guides.forEach(function(g){ %><%- include('partials/guide-card', { g: g }) %><% }) %></div></section>
<% } %>

<%- include('partials/advisor-banner', { bannerTitle: 'Get ' + product.short.toLowerCase() + ' quotes from an advisor licensed in ' + prov.name, bannerWhere: prov.name, bannerProduct: product.slug }) %>

<section class="container-site pb-space-lg"><p class="font-body-sm text-body-sm text-on-surface-variant">Sources: <% (prov.sources || []).forEach(function(src, i){ %><a class="link" href="<%= src %>" rel="noopener nofollow" target="_blank"><%= src.replace(/^https?:\/\/(www\.)?/, '').split('/')[0] %></a><%= i < prov.sources.length - 1 ? ', ' : '' %><% }) %><%= (prov.sources || []).length ? '. ' : '' %>Estimates are modelled by Instasure for the example profile shown and are not quotes. Last reviewed <%= U.monthYear() %>.</p></section>
