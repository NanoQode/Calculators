<% var where = city ? city.name : prov.name; %>
<section class="container-site pt-space-md pb-space-xl">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-xl items-start">
    <div class="lg:col-span-7 flex flex-col gap-space-md">
      <div class="flex flex-wrap gap-space-xs">
        <span class="chip bg-secondary-container/40 text-on-secondary-container"><span class="material-symbols-outlined text-[15px]">location_on</span> <%= city ? city.name + ', ' + prov.abbr : prov.name %></span>
        <span class="chip bg-surface-container text-on-surface"><span class="material-symbols-outlined text-[15px] text-secondary">gavel</span> <%= prov.regulator.short %></span>
      </div>
      <h1 class="font-display-lg-mobile text-display-lg-mobile lg:font-display-lg lg:text-display-lg text-primary-container tracking-tight text-balance">Insurance in <%= city ? city.name + ', ' + prov.abbr : prov.name %></h1>
      <p class="font-body-lg text-body-lg text-on-surface-variant"><%= city ? 'Compare car, home, tenant, life and business insurance in ' + city.name + ' — with instant estimates, local risk insight and advisors licensed in ' + prov.name + '.' : 'How insurance works in ' + prov.name + ': who regulates it, how auto insurance is sold, the risks insurers price in, and where to get licensed help.' %></p>
      <% if (!serviceable) { %><div class="flex items-start gap-3 p-space-md rounded-2xl bg-tertiary-fixed/60 text-on-tertiary-fixed-variant"><span class="material-symbols-outlined">info</span><p class="font-body-sm text-body-sm"><strong>Advisor service in <%= prov.name %> is coming soon.</strong> <%= s.waitlist_message %></p></div><% } %>
    </div>
    <div class="lg:col-span-5 grid grid-cols-2 gap-space-sm">
      <div class="card p-space-md"><span class="font-label-sm text-label-sm text-on-surface-variant">Regulator</span><a href="<%= prov.regulator.url %>" rel="noopener" target="_blank" class="block font-label-lg text-label-lg text-on-surface hover:text-secondary"><%= prov.regulator.short %></a></div>
      <div class="card p-space-md"><span class="font-label-sm text-label-sm text-on-surface-variant">Auto insurance</span><span class="block font-label-lg text-label-lg text-on-surface"><%= prov.auto.system === 'public' ? 'Public (' + prov.auto.publicInsurer + ')' : prov.auto.system === 'hybrid' ? 'SAAQ + private' : 'Private market' %></span></div>
      <div class="card p-space-md"><span class="font-label-sm text-label-sm text-on-surface-variant">Population</span><span class="block font-label-lg text-label-lg text-on-surface">~<%= U.compact(city ? city.pop : prov.population) %></span></div>
      <div class="card p-space-md"><span class="font-label-sm text-label-sm text-on-surface-variant">Advisor service</span><span class="block font-label-lg text-label-lg <%= serviceable ? 'text-secondary' : 'text-on-tertiary-container' %>"><%= serviceable ? 'Available' : 'Waitlist' %></span></div>
    </div>
  </div>
</section>

<section class="w-full bg-surface-container-lowest py-space-xl shadow-sm" aria-labelledby="p-h">
  <div class="container-site">
    <p class="eyebrow">Coverage in <%= where %></p>
    <h2 id="p-h" class="font-headline-lg-mobile text-headline-lg-mobile lg:font-headline-lg lg:text-headline-lg text-primary-container mb-space-lg">Choose what you want to insure</h2>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-space-sm sm:gap-space-md">
      <% allProducts.filter(function(p){ return p.geo !== 'none'; }).forEach(function(p){ var href = '/' + p.slug + '/' + prov.slug + '/' + (city && p.geo === 'city' ? city.slug + '/' : ''); %>
      <a href="<%= href %>" class="group card card-hover p-space-md flex flex-col gap-2 bg-surface-container-low">
        <span class="w-10 h-10 rounded-xl bg-surface-container-lowest flex items-center justify-center text-secondary"><span class="material-symbols-outlined"><%= p.icon %></span></span>
        <span class="font-label-lg text-label-lg text-on-surface group-hover:text-secondary"><%= p.name %> <%= city && p.geo === 'city' ? city.name : prov.abbr %></span>
      </a>
      <% }) %>
    </div>
  </div>
</section>

<section class="container-site py-space-xl grid grid-cols-1 lg:grid-cols-2 gap-space-lg">
  <div class="card p-space-lg">
    <div class="flex items-center gap-2 mb-space-sm"><span class="material-symbols-outlined text-secondary">directions_car</span><h2 class="font-headline-md text-headline-md text-primary-container">How auto insurance works in <%= prov.name %></h2></div>
    <ul class="space-y-2"><% prov.autoNotes.forEach(function(n){ %><li class="flex items-start gap-2 font-body-md text-body-md text-on-surface"><span class="material-symbols-outlined text-[18px] text-secondary mt-0.5">check_circle</span><span><%= n %></span></li><% }) %></ul>
  </div>
  <div class="card p-space-lg">
    <div class="flex items-center gap-2 mb-space-sm"><span class="material-symbols-outlined text-on-tertiary-container">thunderstorm</span><h2 class="font-headline-md text-headline-md text-primary-container">Risks insurers price in <%= where %></h2></div>
    <ul class="space-y-2"><% (city ? city.risks.concat(prov.risks.slice(0,2)) : prov.risks).forEach(function(r){ %><li class="flex items-start gap-2 font-body-md text-body-md text-on-surface"><span class="material-symbols-outlined text-[18px] text-on-tertiary-container mt-0.5">warning</span><span><%= r %></span></li><% }) %></ul>
    <p class="font-body-sm text-body-sm text-on-surface-variant mt-space-md"><%= prov.licensing %></p>
  </div>
</section>

<% if (cities.length) { %>
<section class="container-site pb-space-xl">
  <h2 class="font-headline-md text-headline-md text-primary-container mb-space-md"><%= city ? 'Nearby cities' : 'Cities in ' + prov.name %></h2>
  <ul class="flex flex-wrap gap-2"><% cities.forEach(function(c){ var cp = geoData.provinceByCode[c.prov]; %><li><a href="/insurance/<%= cp.slug %>/<%= c.slug %>/" class="chip bg-surface-container-lowest shadow-sm text-on-surface hover:text-secondary !py-2 !px-3 font-label-md text-label-md"><span class="material-symbols-outlined text-[16px] text-secondary">location_city</span><%= c.name %></a></li><% }) %></ul>
</section>
<% } %>

<% if (advisors.length) { %>
<section class="container-site pb-space-xl"><p class="eyebrow">Licensed in <%= prov.name %></p><h2 class="font-headline-md text-headline-md text-primary-container mb-space-md">Advisors serving <%= where %></h2>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-space-md"><% advisors.forEach(function(a){ %><%- include('partials/advisor-card', { a: a }) %><% }) %></div></section>
<% } %>

<% if (guides.length) { %>
<section class="container-site pb-space-xl"><h2 class="font-headline-md text-headline-md text-primary-container mb-space-md">Guides for <%= prov.name %></h2>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-space-lg"><% guides.forEach(function(g){ %><%- include('partials/guide-card', { g: g }) %><% }) %></div></section>
<% } %>

<%- include('partials/faq', { items: faq, faqHeading: 'Insurance in ' + where + ': FAQ' }) %>
<%- include('partials/advisor-banner', { bannerTitle: 'Get matched with an advisor licensed in ' + prov.name, bannerWhere: prov.name }) %>
