{
  "name": "instasure.ca",
  "version": "1.0.0",
  "private": true,
  "description": "Instasure.ca \u2014 Canada-wide insurance information, instant quotes and licensed-advisor lead generation platform with an SEO-first CMS and lead-management backend.",
  "main": "server.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i ./src/styles/site.css -o ./public/assets/site.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i ./src/styles/site.css -o ./public/assets/site.css --watch",
    "build": "npm run build:css",
    "seed": "node --disable-warning=ExperimentalWarning scripts/seed.js",
    "keywords:report": "node scripts/keyword-report.js",
    "indexnow:submit": "node --disable-warning=ExperimentalWarning scripts/indexnow-submit.js",
    "team-advisor": "node --disable-warning=ExperimentalWarning scripts/team-advisor.js",
    "guides:check": "node --disable-warning=ExperimentalWarning scripts/check-guide.js",
    "guides:publish": "node --disable-warning=ExperimentalWarning scripts/publish-guides.js",
    "guides:next": "node scripts/next-topics.js",
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "dev": "npm run build:css && NODE_ENV=development node --disable-warning=ExperimentalWarning --watch server.js",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 test/*.test.js"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "ejs": "^6.0.1",
    "express": "^4.22.3",
    "helmet": "^8.3.0",
    "marked": "^18.0.14",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.14",
    "sanitize-html": "^2.18.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "tailwindcss": "^3.4.19"
  }
}
